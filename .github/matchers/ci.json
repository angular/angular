{
  "problemMatcher": [
    {
      "owner": "angular-tsc",
      "fileLocation": ["relative", "${workspaceRoot}"],
      "pattern": [
        {
          "regexp": "^(?:\\x1b\\[[0-9;]*m)*([^\\s(].*?)\\((\\d+),(\\d+)\\):\\s+(error|warning)\\s+(TS\\d+):\\s+(.*?)(?:\\x1b\\[[0-9;]*m)*$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      ]
    },
    {
      "owner": "angular-tslint",
      "fileLocation": ["absolute"],
      "pattern": [
        {
          "regexp": "^(?:\\x1b\\[[0-9;]*m)*(/[^\\s:]+\\.[cm]?[jt]sx?)(?:\\x1b\\[[0-9;]*m)*:\\d+:\\d+(?:\\x1b\\[[0-9;]*m)*$",
          "file": 1
        },
        {
          "regexp": "^(?:\\x1b\\[[0-9;]*m)*(ERROR|WARNING):\\s+(\\d+):(\\d+)\\s*(?:\\x1b\\[[0-9;]*m)*\\s+(?:\\x1b\\[[0-9;]*m)*(\\S+)\\s*(?:\\x1b\\[[0-9;]*m)*\\s+(?:\\x1b\\[[0-9;]*m)*(.+?)(?:\\x1b\\[[0-9;]*m)*$",
          "severity": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5,
          "loop": true
        }
      ]
    },
    {
      "owner": "angular-bazel-error-abs",
      "severity": "error",
      "fileLocation": ["absolute"],
      "pattern": [
        {
          "regexp": "^(?:\\x1b\\[[0-9;]*m)*ERROR:(?:\\x1b\\[[0-9;]*m)*\\s+(/[^\\s:]+):(\\d+):(?:(\\d+):)?\\s+(.+?)(?:\\x1b\\[[0-9;]*m)*$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    },
    {
      "owner": "angular-bazel-error-rel",
      "severity": "error",
      "fileLocation": ["relative", "${workspaceRoot}"],
      "pattern": [
        {
          "regexp": "^(?:\\x1b\\[[0-9;]*m)*ERROR:(?:\\x1b\\[[0-9;]*m)*\\s+([^\\s/:][^\\s:]*):(\\d+):(?:(\\d+):)?\\s+(.+?)(?:\\x1b\\[[0-9;]*m)*$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    },
    {
      "owner": "angular-ts-circular-deps",
      "severity": "error",
      "fileLocation": ["relative", "${workspaceRoot}"],
      "pattern": [
        {
          "regexp": "^(?:\\x1b\\[[0-9;]*m)*\\s*•\\s+(([^\\s→][^→]*?\\.[cm]?[jt]sx?)\\s+→\\s+.+?)(?:\\x1b\\[[0-9;]*m)*$",
          "message": 1,
          "file": 2
        }
      ]
    },
    {
      "owner": "angular-ng-dev-error",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(?:\\x1b\\[[0-9;]*m)*\\s*(?:[✘x](?:\\x1b\\[[0-9;]*m)*\\s{2,}(?:\\x1b\\[[0-9;]*m)*|!\\s+(?=Invalid\\s))(.+?)(?:\\x1b\\[[0-9;]*m)*$",
          "message": 1
        }
      ]
    }
  ]
}
