{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "out",
    "baseUrl": ".",
    "paths": {
      "@angular/compiler-cli/private/*": ["../packages/compiler-cli/private/*"],
      "@angular/compiler-cli": ["../packages/compiler-cli/index.ts"],
      "@angular/compiler": ["../packages/compiler/index.ts"],
      "@angular/language-service/private": ["../packages/language-service/private.ts"],
      "@angular/language-service/api": ["../packages/language-service/api.ts"],
      "@angular/language-service": ["../packages/language-service/api.ts"],
      "@angular/core": ["../packages/core/index.ts"],
      "vscode-languageserver": ["node_modules/vscode-languageserver/lib/common/api.d.ts"],
      "vscode-languageserver/*": ["node_modules/vscode-languageserver/*"],
      "vscode-uri": ["node_modules/vscode-uri"]
    }
  }
}
