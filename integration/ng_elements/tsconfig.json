{
  "angularCompilerOptions": {
    "annotationsAs": "static fields",
    "annotateForClosureCompiler": true
  },
  "compilerOptions": {
    "module": "es2015",
    "moduleResolution": "bundler",
    "target": "es2022",
    "sourceMap": false,
    "experimentalDecorators": true,
    "outDir": "built",
    "rootDir": ".",
    "declaration": true,
    "skipLibCheck": true,
    "types": []
  },
  "exclude": ["vendor", "node_modules", "built", "dist", "e2e"]
}
