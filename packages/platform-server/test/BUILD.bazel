load("//tools:defaults.bzl", "angular_jasmine_test", "ts_project", "zoneless_jasmine_test")

ts_project(
    name = "dom_utils",
    testonly = True,
    srcs = [
        "dom_utils.ts",
        "hydration_utils.ts",
    ],
    deps = [
        "//packages/common",
        "//packages/core",
        "//packages/platform-browser",
        "//packages/platform-server",
    ],
)

ts_project(
    name = "test_lib",
    testonly = True,
    srcs = glob(
        ["*.ts"],
        exclude = [
            "event_replay_spec.ts",
            "hydration_utils.ts",
            "dom_utils.ts",
            "class_resolver_auto_hydration_spec.ts",
            "class_resolver_hydration_cases.ts",
        ],
    ),
    deps = [
        ":attribute_resolver_hydration_cases",
        ":dom_utils",
        "//:node_modules/rxjs",
        "//packages:types",
        "//packages/animations",
        "//packages/common",
        "//packages/common/http",
        "//packages/common/http/testing",
        "//packages/common/testing",
        "//packages/compiler",
        "//packages/core",
        "//packages/core/testing",
        "//packages/localize",
        "//packages/localize/init",
        "//packages/platform-browser",
        "//packages/platform-browser/animations",
        "//packages/platform-server",
        "//packages/platform-server/third_party/domino:bundled_domino_lib",
        "//packages/private/testing",
        "//packages/router",
    ],
)

ts_project(
    name = "attribute_resolver_hydration_cases",
    testonly = True,
    srcs = ["class_resolver_hydration_cases.ts"],
    deps = [
        ":dom_utils",
        "//packages/common",
        "//packages/core",
    ],
)

# Automatic resolution turns its runtime on for the whole process, so its hydration specs run
# in their own target, apart from the specs above that must run without it.
ts_project(
    name = "attribute_resolver_auto_hydration_test_lib",
    testonly = True,
    srcs = ["class_resolver_auto_hydration_spec.ts"],
    deps = [
        ":attribute_resolver_hydration_cases",
        ":dom_utils",
        "//packages/common",
        "//packages/core",
        "//packages/core/testing",
    ],
)

ts_project(
    name = "event_replay_test_lib",
    testonly = True,
    srcs = ["event_replay_spec.ts"],
    deps = [
        ":dom_utils",
        "//packages/common",
        "//packages/core",
        "//packages/core/primitives/event-dispatch",
        "//packages/core/testing",
        "//packages/platform-browser",
        "//packages/platform-server",
        "//packages/private/testing",
    ],
)

# This target is meant to run with Zone.js as some test cases are shared between Zone & Zoneless.
angular_jasmine_test(
    name = "test",
    data = [
        ":test_lib",
        "//packages/core/primitives/event-dispatch:contract_bundle_min",
    ],
)

zoneless_jasmine_test(
    name = "event_replay_test",
    data = [
        ":event_replay_test_lib",
        "//packages/core/primitives/event-dispatch:contract_bundle_min",
    ],
)

angular_jasmine_test(
    name = "attribute_resolver_auto_hydration_test",
    data = [
        ":attribute_resolver_auto_hydration_test_lib",
        "//packages/core/primitives/event-dispatch:contract_bundle_min",
    ],
)
