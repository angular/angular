load("//tools:defaults.bzl", "js_binary", "npm_package", "ts_config", "ts_project")

package(default_visibility = ["//visibility:public"])

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = [
        "//packages:tsconfig_build",
    ],
)

ts_project(
    name = "preprocessor",
    srcs = glob(
        include = [
            "*.ts",
            "src/**/*.ts",
        ],
        exclude = [
            "serve.ts",
            "src/diagnostics.ts",
        ],
    ),
    tsconfig = ":tsconfig",
    deps = [
        "//:node_modules/@types/node",
        "//:node_modules/magic-string",
        "//:node_modules/typescript",
        "//packages/common",
        "//packages/compiler",
        "//packages/compiler-cli",
        "//packages/compiler-cli/preprocessor/ng-analyze:wasm",
        "//packages/compiler-cli/private",
    ],
)

ts_project(
    name = "serve_lib",
    srcs = ["serve.ts"],
    tsconfig = ":tsconfig",
    deps = [
        ":preprocessor",
        "//:node_modules/@types/node",
        "//:node_modules/esbuild",
        "//:node_modules/typescript",
        "//packages/compiler-cli/linker/babel",
    ],
)

js_binary(
    name = "main",
    data = [
        ":preprocessor",
        "//packages/compiler-cli/preprocessor/ng-analyze:ng_analyze_wasm",
        "//packages/compiler-cli/preprocessor/ng-analyze:package_json",
    ],
    entry_point = "main.js",
)

js_binary(
    name = "serve",
    data = [
        ":preprocessor",
        ":serve_lib",
        "//packages/compiler-cli/preprocessor/ng-analyze:ng_analyze_wasm",
        "//packages/compiler-cli/preprocessor/ng-analyze:package_json",
    ],
    entry_point = "serve.js",
)

npm_package(
    srcs = [
        "package.json",
        ":preprocessor",
    ],
    package = "@angular/compiler-cli/preprocessor",
)
