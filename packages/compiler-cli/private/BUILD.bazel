load("//tools:defaults.bzl", "copy_to_bin", "ts_project")

package(default_visibility = ["//visibility:public"])

copy_to_bin(
    name = "files",
    srcs = [
        "localize.ts",
        "migrations.ts",
        "testing.ts",
        "tooling.ts",
    ],
)

copy_to_bin(
    name = "hybrid_analysis",
    srcs = [
        "hybrid_analysis.ts",
    ],
)

copy_to_bin(
    name = "hybrid_preprocessor_files",
    srcs = [
        "hybrid_preprocessor.ts",
    ],
)

ts_project(
    name = "hybrid_preprocessor",
    srcs = ["hybrid_preprocessor.ts"],
    deps = [
        "//packages/compiler",
        "//packages/compiler-cli/src/ngtsc/hmr:extract_dependencies_output",
        "//packages/compiler-cli/src/ngtsc/imports:core_symbols",
    ],
)

ts_project(
    name = "private",
    srcs = glob(
        ["*.ts"],
        exclude = ["hybrid_preprocessor.ts"],
    ),
    deps = [
        ":hybrid_preprocessor",
        "//:node_modules/typescript",
        "//packages/compiler-cli/src/ngtsc/annotations",
        "//packages/compiler-cli/src/ngtsc/core",
        "//packages/compiler-cli/src/ngtsc/diagnostics",
        "//packages/compiler-cli/src/ngtsc/file_system",
        "//packages/compiler-cli/src/ngtsc/file_system/testing",
        "//packages/compiler-cli/src/ngtsc/hmr",
        "//packages/compiler-cli/src/ngtsc/imports",
        "//packages/compiler-cli/src/ngtsc/indexer",
        "//packages/compiler-cli/src/ngtsc/logging",
        "//packages/compiler-cli/src/ngtsc/metadata",
        "//packages/compiler-cli/src/ngtsc/partial_evaluator",
        "//packages/compiler-cli/src/ngtsc/perf",
        "//packages/compiler-cli/src/ngtsc/reflection",
        "//packages/compiler-cli/src/ngtsc/shims",
        "//packages/compiler-cli/src/ngtsc/sourcemaps",
        "//packages/compiler-cli/src/ngtsc/transform",
        "//packages/compiler-cli/src/ngtsc/transform/jit",
        "//packages/compiler-cli/src/ngtsc/translator",
        "//packages/compiler-cli/src/ngtsc/typecheck",
        "//packages/compiler-cli/src/ngtsc/typecheck/api",
        "//packages/compiler-cli/src/ngtsc/util",
    ],
)
