load("//tools:defaults.bzl", "ng_web_test_suite", "ts_project", "zoneless_jasmine_test", "zoneless_web_test_suite")

package(default_visibility = ["//visibility:private"])

ts_project(
    name = "off_subtree_cases",
    testonly = True,
    srcs = ["off_subtree_cases.ts"],
    deps = [
        "//packages/core",
        "//packages/core/testing",
    ],
)

ts_project(
    name = "attribute_resolver_lib",
    testonly = True,
    srcs = glob(
        ["**/*.ts"],
        exclude = [
            "auto_attribute_resolution_spec.ts",
            "auto_resolution_security_spec.ts",
            "auto_resolution_spec.ts",
            "off_subtree_cases.ts",
            "style_order_spec.ts",
        ],
    ),
    deps = [
        ":off_subtree_cases",
        "//packages/core",
        "//packages/core/testing",
        "//packages/localize",
        "//packages/localize/init",
        "//packages/platform-browser",
        "//packages/private/testing",
    ],
)

zoneless_jasmine_test(
    name = "attribute_resolver",
    data = [
        ":attribute_resolver_lib",
    ],
)

# Specs whose result depends on how a browser parses CSS, such as the longhands that a shorthand
# sets. Domino doesn't expand shorthands, so they run only in a browser.
ts_project(
    name = "style_order_lib",
    testonly = True,
    srcs = ["style_order_spec.ts"],
    deps = [
        "//packages/core",
        "//packages/core/testing",
    ],
)

ng_web_test_suite(
    name = "attribute_resolver_web",
    deps = [
        ":attribute_resolver_lib",
        ":style_order_lib",
    ],
)

# Automatic resolution turns its runtime on for the whole process, so its specs run in their own
# target, apart from the specs above that must run without it.
ts_project(
    name = "auto_resolution_lib",
    testonly = True,
    srcs = [
        "auto_attribute_resolution_spec.ts",
        "auto_resolution_spec.ts",
    ],
    deps = [
        ":off_subtree_cases",
        "//packages/common",
        "//packages/core",
        "//packages/core/testing",
        "//packages/router",
    ],
)

# The specs of the names of elements, which come from the DOM for a host created in code, so they
# run in Domino and in a browser.
ts_project(
    name = "auto_resolution_security_lib",
    testonly = True,
    srcs = ["auto_resolution_security_spec.ts"],
    deps = [
        "//packages/core",
        "//packages/core/testing",
    ],
)

zoneless_jasmine_test(
    name = "auto_resolution",
    data = [
        ":auto_resolution_lib",
        ":auto_resolution_security_lib",
    ],
)

zoneless_web_test_suite(
    name = "auto_resolution_web",
    deps = [
        ":auto_resolution_security_lib",
    ],
)
