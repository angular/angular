load("//tools:defaults.bzl", "ts_project")

package(default_visibility = ["//visibility:public"])

ts_project(
    name = "localize",
    srcs = glob(
        [
            "**/*.ts",
        ],
    ),
    deps = [
        "//:node_modules/@types/node",
        "//packages/localize/src/utils",
    ],
)

filegroup(
    name = "files_for_docgen",
    srcs = glob([
        "*.ts",
        "src/**/*.ts",
    ]),
)
