+/**
+ * Transforms a source file according to Angular's Google sync comment markers
+ * (`contributing-docs/google-markers.md`) for g3-mode compilation.
+ */
+function transformToG3(content: string): string {
+  if (!content.includes('g3-only') && !content.includes('3p-only')) {
+    return content;
+  }
+
+  const lines = content.split('\n');
+  const out: string[] = [];
+  let in3pBlock = false;
+  let inG3Block = false;
+
+  for (const line of lines) {
+    if (/^\s*\/\/\s*3p-only-start\b/.test(line)) {
+      in3pBlock = true;
+      continue;
+    }
+    if (/^\s*\/\/\s*3p-only-end\b/.test(line)) {
+      in3pBlock = false;
+      continue;
+    }
+    if (in3pBlock) {
+      continue;
+    }
+    if (/^\s*\/\/\s*g3-only-start\b/.test(line)) {
+      inG3Block = true;
+      continue;
+    }
+    if (/^\s*\/\/\s*g3-only-end\b/.test(line)) {
+      inG3Block = false;
+      continue;
+    }
+    if (inG3Block) {
+      out.push(line.replace(/^(\s*)\/\/ ?/, '$1'));
+      continue;
+    }
+    if (/\/\/\s*3p-only\s*$/.test(line)) {
+      // Keep `/// <reference path="...goog.d.ts" />` since Closure globals aren't ambient in 3P Bazel.
+      if (!/\/\/\/\s*<reference\s+path=.*goog\.d\.ts/.test(line)) {
+        continue;
+      }
+    }
+    if (/^\s*\/\/\s*g3-only\b/.test(line)) {
+      out.push(line.replace(/^(\s*)\/\/\s*g3-only ?/, '$1'));
+      continue;
+    }
+    out.push(line);
+  }
+  return out.join('\n');
+}
