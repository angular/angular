load("@rules_angular//src/optimization:index.bzl", "optimize_angular_app")
load("//modules/benchmarks:benchmark_test.bzl", "benchmark_test")
load("//modules/benchmarks:e2e_test.bzl", "e2e_test")
load("//tools:defaults.bzl", "http_server", "ts_project")

package(default_visibility = ["//modules/benchmarks:__subpackages__"])

ts_project(
    name = "perf_tests_lib",
    testonly = True,
    srcs = ["isolated_reactivity.perf-spec.ts"],
    tsconfig = "//modules/benchmarks:tsconfig_e2e",
    deps = [
        "//modules:node_modules/protractor",
        "//modules/utilities",
    ],
)

ts_project(
    name = "e2e_tests_lib",
    testonly = True,
    srcs = ["isolated_reactivity.e2e-spec.ts"],
    tsconfig = "//modules/benchmarks:tsconfig_e2e",
    deps = [
        "//modules:node_modules/protractor",
        "//modules/utilities",
    ],
)

optimize_angular_app(
    name = "bundles",
    srcs = [
        "benchmark.ts",
        "index.html",
        "init.ts",
        "main.ts",
        "//modules/benchmarks/src:util_lib",
    ],
    include_zonejs = False,
    deps = [
        "//modules:node_modules/@angular/build",
        "//modules:node_modules/@angular/core",
        "//modules:node_modules/@angular/platform-browser",
        "//modules:node_modules/rxjs",
        "//modules:node_modules/tslib",
    ],
)

genrule(
    name = "app_bundle",
    srcs = [":bundles"],
    outs = ["app_bundle.js"],
    cmd = "cp $</main.js $@",
)

http_server(
    name = "prodserver",
    srcs = ["index.html"],
    deps = [":app_bundle"],
)

benchmark_test(
    name = "perf",
    server = ":prodserver",
    deps = [":perf_tests_lib"],
)

e2e_test(
    name = "e2e",
    server = ":prodserver",
    deps = [":e2e_tests_lib"],
)
