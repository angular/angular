        "adev/src/content/cli/cli_docs_html": "cli/",
        "adev/src/content/aria/aria_docs_html": "api/",
        "adev/src/content/cdk/cdk_docs_html": "api/",
        "adev/src/content/api/**/": "api/",
        "adev/src/content": "",
